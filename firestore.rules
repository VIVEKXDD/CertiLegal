rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId && request.resource.data.email != null;
    }

    // Legal documents
    match /documents/{documentId} {
      // Allow creating documents with the correct userId
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Allow reading a single document if the user is the owner OR if the user is v@example.com.
      allow get: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == 'v@example.com');
      
      // Allow querying the collection if the query is filtered by the user's ID OR if the user is v@example.com.
      allow list: if request.auth != null && (request.query.where.userId == request.auth.uid || request.auth.token.email == 'v@example.com');

      // Allow update/delete only by the document owner
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Glossary: Only v@example.com can read or write to the glossary.
    match /glossary/{glossaryId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'v@example.com';
    }
  }
}
